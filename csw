def canonical_profile_label(path):
    for alias, filename in ALIASES.items():
        if path.name == filename:
            return alias
    match = re.fullmatch(r"settings\.json\.(CODEX|CURSOR|CLAUDE|GLM|DEEPSEEK|ORCAROUTER)\.([a-z0-9_-]+)\.bak", path.name)
    return f"{match[1].lower()}:{match[2]}" if match else path.name


def profile_label(path):
    canonical = canonical_profile_label(path)
    if canonical == "codex":
        match = re.fullmatch(r"Codex \(([a-z0-9][a-z0-9_-]{0,31})\)", names().get(path.name, ""))
        if match:
            account = ROOT / f"settings.json.CODEX.{match[1]}.bak"
            if not account.is_file():
                return f"codex:{match[1]}"
    return canonical


def effective_model(data):
    env = data.get("env", {})
    model = str(env.get("ANTHROPIC_MODEL") or data.get("model") or "default")
    alias = re.sub(r"\[1m\]$", "", model)
    return str(env.get(f"ANTHROPIC_DEFAULT_{alias.upper()}_MODEL") or model)


