def set_name(path, label):
    if not label or any(c in label for c in "\t\r\n"):
        raise ValueError("La etiqueta debe ser una línea de texto")
    if path.name == ALIASES["codex"] and label != "codex" and re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,31}", label):
        account = ROOT / f"settings.json.CODEX.{label}.bak"
        if account.is_file():
            raise ValueError(f"Ya existe la cuenta codex:{label}; elige otro nombre")
        label = f"Codex ({label})"
    labels = names()
    labels[path.name] = label
    atomic_write(NAMES, "".join(f"{key}\t{value}\n" for key, value in labels.items()))


def doctor():
    problems = []
    for alias, filename in ALIASES.items():
        try:
            data = read_json(ROOT / filename)
            print(f"{alias}: configuración válida; {provider(data)}")
        except (OSError, ValueError):
            problems.append(alias)
            print(f"{alias}: falta el perfil o su JSON es inválido")
    environment = {k: v for k, v in os.environ.items() if not provider_key(k)}
    try:
        environment.pop("CLAUDE_CONFIG_DIR", None)
        status = subprocess.run([CLAUDE_BIN, "--setting-sources", "", "auth", "status", "--json"],
                                capture_output=True, text=True, timeout=20, env=environment)
        native_login = json.loads(status.stdout).get("loggedIn") is True
    except (OSError, ValueError, subprocess.TimeoutExpired):
        native_login = False
    print("Claude sub: " + ("login presente" if native_login else "pendiente: csw login claude"))
    if not native_login:
        problems.append("claude-login")
    ready = proxy_ready()
    print("Proxy local: " + ("responde" if ready else "no responde"))
    if not ready:
        problems.append("proxy")
    for backend in ("codex", "cursor"):
        try:
            _, environment, _ = proxy_context(read_json(ROOT / ALIASES[backend]))
            present = authenticated(backend, environment)
        except (OSError, subprocess.TimeoutExpired):
            present = False
        print(f"{backend}: " + ("credenciales presentes" if present else f"pendiente: csw login {backend}"))
        if not present:
            problems.append(backend)
    for path in sorted((CONFIG_ROOT / "accounts").glob("*/config.json")):
        data = read_json(path)
        target = {"env": {"ANTHROPIC_BASE_URL": f"http://127.0.0.1:{data['port']}"}}
        url, environment, _ = proxy_context(target)
        backend = path.parent.name.split("-", 1)[0]
        present = authenticated(backend, environment)
        ready = proxy_ready(url)
        print(f"{path.parent.name}: credenciales={'sí' if present else 'pendientes'}, proxy={'activo' if ready else 'parado'}")
        if not present or not ready:
            problems.append(path.parent.name)
    print("Comprobación local; no verifica cuota ni una respuesta del proveedor.")
    print("Cursor: herramientas nativas incompatibles con este adaptador; ahora se notifican como error, no como una tarea completada.")
    problems.append("cursor-tools")
    return 1 if problems else 0


def native_environment(profile):
    environment = {k: v for k, v in os.environ.items() if not provider_key(k)}
    environment.pop("CLAUDE_CONFIG_DIR", None)
    if ROOT != Path.home() / ".claude":
        environment["CLAUDE_CONFIG_DIR"] = str(ROOT)
    account = re.fullmatch(r"settings\.json\.CLAUDE\.([a-z0-9_-]+)\.bak", profile.name)
    if account:
        directory = ROOT / "accounts" / "claude" / account[1]
        if not directory.is_dir():
            raise ValueError("No existe el directorio de sesión de esa cuenta Claude")
        ensure_native_links(directory)
        environment["CLAUDE_CONFIG_DIR"] = str(directory)
    return environment


def ensure_native_links(directory):
    for name in SHARED_RESOURCES:
        source = ROOT / name
        destination = directory / name
        if source.exists() and not destination.exists() and not destination.is_symlink():
            destination.symlink_to(source, target_is_directory=source.is_dir())


def prepare_native_account(slug, target):
    directory = ROOT / "accounts" / "claude" / slug
    directory.mkdir(mode=0o700, parents=True)
    write_json(directory / "settings.json", merge_provider(read_json(LIVE), target))
    ensure_native_links(directory)
    # Copy only personal MCP definitions; account metadata and tokens stay isolated.
    global_config = ROOT.parent / ".claude.json"
    if global_config.is_file():
        mcp = read_json(global_config).get("mcpServers")
        if mcp:
            write_json(directory / ".claude.json", {"mcpServers": mcp})


def login(value, device=None, browser=False):
    with account_lock(resolve(value)):
        return perform_login(value, device, browser)


def perform_login(value, device=None, browser=False):
    profile = resolve(value)
    target = read_json(profile)
    backend = provider(target).lower()
    if device and browser:
        raise ValueError("Elige solo un modo de login: dispositivo o navegador")
    if backend == "claude sub" and not device:
        result = subprocess.call([CLAUDE_BIN, "--setting-sources", "", "auth", "login", "--claudeai"],
                                 env=native_environment(profile))
        if result == 0 and profile.name == active():
            switch(value)
        return result
    if backend not in ("codex", "cursor") or (device and backend != "codex"):
        raise ValueError("Login del proxy: codex o cursor; dispositivo solo para Codex")
    _, environment, unit = proxy_context(target)
    # Codex defaults to OAuth device code: short URL + one-time code. Browser
    # callback login remains available only when the operator asks for it.
    auth_command = "device" if backend == "codex" and not browser else "login"
    result = subprocess.call(["claude-code-proxy", backend, "auth", auth_command], env=environment)
    if result == 0:
        subprocess.run(["systemctl", "--user", "enable", "--now", unit], check=True)
        print(f"Cuenta lista. Para seleccionarla: csw {value}")
    return result


def account_seed(backend):
    primary = ROOT / ALIASES.get(backend, "")
    return read_json(primary) if primary.is_file() else copy.deepcopy(ACCOUNT_TEMPLATES[backend])


def add_account(backend, slug, device=None, browser=False):
    if backend not in ("codex", "cursor", "claude", "glm", "deepseek", "orcarouter") or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,31}", slug):
        raise ValueError("Usa csw add codex|cursor|claude|glm|deepseek|orcarouter nombre; nombre en minúsculas, números, guion o guion bajo")
    if device and browser:
        raise ValueError("Elige solo un modo de login: dispositivo o navegador")
    if device and backend != "codex":
        raise ValueError("--device solo está disponible para Codex")
    if browser and backend not in ("codex", "cursor", "claude"):
        raise ValueError("--browser solo está disponible para Claude, Codex o Cursor")
    directory = CONFIG_ROOT / "accounts" / f"{backend}-{slug}"
    profile = profile_path(f"settings.json.{backend.upper()}.{slug}.bak")
    if backend in ("claude", "glm", "deepseek", "orcarouter"):
        if profile.exists() or (backend == "claude" and (ROOT / "accounts" / "claude" / slug).exists()):
            raise ValueError(f"La cuenta ya existe: {backend}:{slug}")
        target = merge_provider({}, account_seed(backend))
        if backend != "claude":
            key = getpass.getpass(f"Clave API de {backend} ({slug}): ").strip()
            if not key:
                raise ValueError("Clave vacía; no se ha creado la cuenta")
            target["env"]["ANTHROPIC_AUTH_TOKEN"] = key
        with locked():
            if profile.exists():
                raise ValueError("La cuenta ya existe")
            if backend == "claude":
                prepare_native_account(slug, target)
            write_json(profile, target)
            set_name(profile, f"{backend.title()} ({slug})")
        print(f"Cuenta creada: {backend}:{slug}. Para abrirla: csw run {backend}:{slug}")
        return login(f"{backend}:{slug}", browser=browser) if backend == "claude" else 0
    with locked():
        if directory.exists() or profile.exists():
            raise ValueError(f"La cuenta ya existe. Usa csw login {backend}:{slug}")
        base = account_seed(backend)
        reserved = {read_json(p).get("port") for p in (CONFIG_ROOT / "accounts").glob("*/config.json")}
        for port in range(18766, 18866):
            if port in reserved:
                continue
            with socket.socket() as listener:
                try:
                    listener.bind(("127.0.0.1", port))
                    break
                except OSError:
                    continue
        else:
            raise ValueError("No quedan puertos disponibles para nuevas cuentas")
        directory.mkdir(mode=0o700, parents=True)
        write_json(directory / "config.json", {"bindAddress": "127.0.0.1", "port": port, "aliasProvider": "codex"})
        target = merge_provider({}, base)
        target["env"]["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
        write_json(profile, target)
        set_name(profile, f"{backend.title()} ({slug})")
    print(f"Cuenta creada: {backend}:{slug}. Cada cuenta conserva su login y su proxy.")
    suffix = " --browser" if backend == "codex" and browser else ""
    print(f"Si interrumpes el login: csw login {backend}:{slug}{suffix}")
    return login(f"{backend}:{slug}", device=device, browser=browser)


def launch_claude(args):
    """Normal shell launch: user settings remain the live source of the route."""
    forwarded = args[1:] if args and args[0] == "--" else args
    if forwarded and forwarded[0] == "auth":
        return run_claude(["--", *forwarded])
    environment = {k: v for k, v in os.environ.items() if not provider_key(k)}
    environment["CLAUDE_CONFIG_DIR"] = str(ROOT)
    for key in ("CSW_HOT_ID", "CSW_HOT_REVISION"):
        environment.pop(key, None)
    environment.pop("CSW_SHARED_DISABLED", None)
    local = bool(forwarded and forwarded[0] in (
        "mcp", "plugin", "plugins", "doctor", "update", "upgrade", "install", "agents", "auth",
        "attach", "logs", "respawn", "rm", "stop", "kill", "project", "gateway", "import",
        "auto-mode", "setup-token", "ultrareview"))
    if not local and not any(arg in ("--version", "-v", "--help", "-h") for arg in forwarded):
        target = read_json(LIVE)
        model = effective_model(target)
        for index, arg in enumerate(forwarded):
            if arg == "--model" and index + 1 < len(forwarded):
                model = normalize_model(forwarded[index + 1], target)
            elif arg.startswith("--model="):
                model = normalize_model(arg.split("=", 1)[1], target)
        # --model determines only startup; native /model can change it afterward.
        # It also prevents --resume from restoring a different provider's model.
        forwarded = [*forwarded, "--model", model]
        environment["CSW_INITIAL_MODEL"] = model
    # No --settings snapshot or provider credentials. Claude watches ROOT itself.
    return os.execvpe(CLAUDE_BIN, [CLAUDE_BIN, *forwarded], environment)


def run_claude(args):
    # The shell wrapper inserts -- so native Claude positional arguments remain untouched.
    explicit = bool(args and args[0] != "--" and not args[0].startswith("-"))
    profile = resolve(args[0]) if explicit else resolve(active()) if active() else None
    forwarded = args[1:] if explicit or (args and args[0] == "--") else args
    if forwarded and forwarded[0] == "--":
        forwarded = forwarded[1:]
    current = read_json(LIVE)
    target = merge_provider(current, selected_data(profile)) if explicit else current
    target = provider_transport(target)
    if provider(target) == "Claude sub":
        # Isolated native sessions own their canonical login store and renewal.
        target.setdefault("env", {}).pop("CLAUDE_CODE_OAUTH_TOKEN", None)
    prefer_supported_context(target)
    if profile is None:
        profile = LIVE
    environment = native_environment(profile)
    environment["CSW_SHARED_DISABLED"] = "1"
    if forwarded and forwarded[0] == "auth":
        with account_lock(profile):
            return subprocess.call([CLAUDE_BIN, "--setting-sources", "", *forwarded], env=environment)
    if any(arg in ("--version", "-v", "--help", "-h") for arg in forwarded):
        return subprocess.call([CLAUDE_BIN, *forwarded], env=environment)
    forwarded, extra_settings = extract_extra_settings(forwarded)
    model_override = None
    for index, argument in enumerate(forwarded):
        if argument == "--model" and index + 1 < len(forwarded):
            forwarded[index + 1] = normalize_model(forwarded[index + 1], target)
            model_override = forwarded[index + 1]
        elif argument.startswith("--model="):
            model_override = normalize_model(argument.split("=", 1)[1], target)
            forwarded[index] = "--model=" + model_override
    if model_override:
        prefer_supported_context(target, model_override)
    with account_lock(profile):
        if not profile.exists():
            raise ValueError("La cuenta se retiró antes de iniciar la sesión")
        local_command = bool(forwarded and forwarded[0] in ("mcp", "plugin", "plugins", "doctor", "update"))
        if not local_command:
            check_proxy(target)
            configure_model_picker(target, profile)
        environment.update({k: str(v) for k, v in target.get("env", {}).items()})
        environment["CSW_PROFILE"] = profile_label(profile)
        environment["CSW_PROVIDER"] = provider(target)
        directory = ROOT / "run-settings"
        directory.mkdir(mode=0o700, exist_ok=True)
        fd, filename = tempfile.mkstemp(prefix="session-", suffix=".json", dir=directory)
        os.close(fd)
        snapshot = Path(filename)
        try:
            overlay = launch_overlay(target, current)
            overlay.update({key: value for key, value in extra_settings.items() if key != "env"})
            overlay["env"].update(extra_settings.get("env", {}))
            write_json(snapshot, overlay)
            # User scope owns MCP servers, skills and agents. Keep it enabled and
            # override only the provider, so hooks and permission lists load once.
            return subprocess.call([CLAUDE_BIN, "--setting-sources", "user,project,local", "--settings", str(snapshot), *forwarded], env=environment)
        finally:
            snapshot.unlink(missing_ok=True)


def extract_extra_settings(args):
    forwarded = []
    extra = {}
    index = 0
    while index < len(args):
        value = None
        argument = args[index]
        if argument == "--settings":
            index += 1
            if index >= len(args):
                raise ValueError("Falta el valor de --settings")
            value = args[index]
        elif argument.startswith("--settings="):
            value = argument.split("=", 1)[1]
        if value is None:
            forwarded.append(argument)
        else:
            extra = json.loads(value) if value.lstrip().startswith("{") else read_json(Path(value).expanduser())
            if not isinstance(extra, dict) or not isinstance(extra.get("env", {}), dict):
                raise ValueError("--settings debe contener un objeto de configuración")
        index += 1
    return forwarded, extra


def launch_overlay(target, inherited):
    # Omitting an env key from --settings does not delete an inherited value.
    # Empty credential values mask the previous provider without changing disk.
    keys = {key for key in inherited.get("env", {}) if provider_key(key)}
    keys.update(("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
                 "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY"))
    env = {key: "" for key in keys}
    env.update({key: value for key, value in target.get("env", {}).items() if provider_key(key)})
    if provider(target) == "Claude sub":
        env["ANTHROPIC_BASE_URL"] = "https://api.anthropic.com"
    overlay = {"env": env}
    for key in (*PROVIDER_FIELDS, "modelPicker"):
        if key in target:
            overlay[key] = copy.deepcopy(target[key])
    if "apiKeyHelper" in inherited and "apiKeyHelper" not in target:
        overlay["apiKeyHelper"] = ""
    return overlay


def support_module(name):
    # Search order: CSW_MODULES_DIR, ./modules next to this script, then the
    # user install location (~/.local/share/csw) that install.sh creates.
    candidates = [os.environ.get("CSW_MODULES_DIR"),
                  str(Path(__file__).resolve().parent / "modules"),
                  str(Path.home() / ".local/share/csw")]
    filename = next((Path(base, name + ".py") for base in candidates
                     if base and Path(base, name + ".py").is_file()),
                    Path.home() / f".local/share/csw/{name}.py")
    spec = importlib.util.spec_from_file_location(f"csw_{name}", filename)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def hot_module():
    return support_module("hot")


def ui_module():
    return support_module("ui")


def shared_module():
    return support_module("shared")


def main(args):
    if not args or args[0] == "menu":
        if sys.stdin.isatty():
            return ui_module().home(types.SimpleNamespace(**globals()))
        show_list()
    elif args[0] in ("help", "-h", "--help"):
        if args[1:] not in ([], ["--all"]):
            raise ValueError("Usa csw help para empezar o csw help --all para todos los comandos")
        ui_module().help_text(full="--all" in args)
    elif args[0] == "hot":
        return hot_module().main(types.SimpleNamespace(**globals()), args[1:])
    elif args[0] in ("list", "l"):
        show_list("--all" in args)
    elif args[0] == "active":
        data = read_json(LIVE)
        prefer_supported_context(data)
        print(f"Perfil: {profile_label(ROOT / active()) if active() else 'sin marcar'}\nProveedor: {provider(data)}\nModelo principal: {effective_model(data)}")
        env = data.get("env", {})
        print(f"Contexto documentado/configurado: {context_label(effective_model(data), data)}\nVentana de compactación: {env.get('CLAUDE_CODE_AUTO_COMPACT_WINDOW', 'automática nativa')} tokens (Claude reserva su margen interno)")
        subagents = env.get("CLAUDE_CODE_SUBAGENT_MODEL")
        subagents = "heredan el /model y /effort vivos de la sesión" if subagents in (None, "", "inherit") else subagents
        print(f"Modelo auxiliar: {env.get('ANTHROPIC_SMALL_FAST_MODEL', 'predeterminado del proveedor')}\nSubagentes nuevos: {subagents}")
        print("Configuración compartida de settings.json; el modelo de cada sesión aparece en su barra de estado.")
    elif args[0] == "models":
        values = [a for a in args[1:] if a != "--refresh"]
        if len(values) > 1:
            raise ValueError("Usa csw models [perfil] [--refresh]")
        print_models(resolve(values[0] if values else active()), "--refresh" in args)
    elif args[0] == "model" and len(args) in (2, 3):
        select_model(args[1], args[2] if len(args) == 3 else None)
    elif args[0] in ("remove", "rm") and len(args) == 2:
        remove_account(args[1])
    elif args[0] == "restore" and len(args) == 2:
        restore_account(args[1])
    elif args[0] == "statusline":
        payload = json.load(sys.stdin)
        try:
            shared_module().observe_model(types.SimpleNamespace(**globals()), payload)
        except (OSError, ValueError, TypeError, AttributeError):
            pass  # Optional telemetry must not break the user's status line.
        print(status_model(payload))
    elif args[0] == "shared-hook":
        try:
            print(json.dumps(shared_module().hook(types.SimpleNamespace(**globals()), json.load(sys.stdin))))
        except Exception as error:
            print(f"csw: {error}", file=sys.stderr)
            return 2  # Claude blocking-hook status; no accidental provider request.
    elif args[0] == "inherit-hook":
        try:
            print(json.dumps(shared_module().inherit_tool(types.SimpleNamespace(**globals()), json.load(sys.stdin))))
        except Exception as error:
            print(f"csw: no se pudo aplicar la herencia: {error}", file=sys.stderr)
            return 2  # Fail closed: never run a workflow with silently wrong routing.
    elif args[0] == "doctor":
        return doctor()
    elif args[0] == "run":
        return run_claude(args[1:])
    elif args[0] == "launch":
        return launch_claude(args[1:])
    elif args[0] == "monitor":
        target = read_json(LIVE)
        url = target.get("env", {}).get("ANTHROPIC_BASE_URL", "")
        if not str(url).startswith("http://127.0.0.1:"):
            url = "http://127.0.0.1:18765"
        return subprocess.call(["claude-code-proxy", "monitor", "--url", url])
    elif args[0] == "add" and len(args) in (3, 4):
        option = args[3] if len(args) == 4 else None
        if option not in (None, "--device", "--browser"):
            raise ValueError("Opción inválida; Codex usa dispositivo por defecto o --browser")
        return add_account(args[1], args[2], device=option == "--device", browser=option == "--browser")
    elif args[0] == "login" and len(args) in (2, 3):
        option = args[2] if len(args) == 3 else None
        if option not in (None, "--device", "--browser"):
            raise ValueError("Opción inválida; Codex usa dispositivo por defecto o --browser")
        with account_lock(resolve(args[1])):
            return login(args[1], device=option == "--device", browser=option == "--browser")
    elif args[0] == "name" and len(args) >= 3:
        with locked():
            set_name(resolve(args[1]), " ".join(args[2:]))
    elif args[0] == "save" and len(args) >= 2:
        path = profile_path(args[1] if args[1].startswith("settings.json.") else "settings.json." + args[1])
        label = " ".join(args[2:]) or args[1]
        if any(c in label for c in "\t\r\n"):
            raise ValueError("La etiqueta debe ser una línea de texto")
        with locked():
            if path.exists():
                raise ValueError("El perfil ya existe; elige otro nombre")
            if ACTIVE.is_symlink() or NAMES.is_symlink():
                raise ValueError("El registro de perfiles no debe ser un enlace simbólico")
            write_json(path, read_json(LIVE))
            set_name(path, label)
            atomic_write(ACTIVE, path.name + "\n")
        print(f"Guardado: {path.name}")
    elif len(args) == 1:
        switch(args[0])
    else:
        raise ValueError("Uso inválido; consulta csw help")
    return 0


if __name__ == "__main__":
    os.umask(0o077)
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"csw: {error}", file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        sys.exit(130)
